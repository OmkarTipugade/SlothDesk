# ── SlothDesk Configuration ──────────────────────────────────────
# Copy this file to .env and adjust values for your setup.

# Absolute path to the directory SlothDesk will organize.
# Default: ~/SlothDesk_Demo (a safe demo folder, NOT your home or Downloads).
SLOTHDESK_ROOT=~/SlothDesk_Demo

# Local Ollama endpoint.  Do not point this at a cloud service.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b

# Request timeout for Ollama inference (seconds).
OLLAMA_TIMEOUT_SECONDS=180

# SQLite database path (kept outside the scanned directory).
# DATABASE_PATH=.slothdesk_data/history.db

# Limits
MAX_SCAN_FILES=500
MAX_FILE_SIZE_MB=50